/** @var \Vipps\Login\Block\Account\Create $block */
?>
<?php if (!$block->isVippsLoggedIn()) : ?>
    <div
        class="login-vipps-holder new-account"
        id="register-area"
        x-data="registerArea()"
        x-init="init()"
    >
        <?= $block->getChildHtml('hyva_vipps_form_register_button') ?>

        <div class="link-toggle mt-2.5 flex" @click="toggle">
            <span class="mr-2.5"><?= $block->escapeHtml(__('or')) ?></span>
            <p class="cursor-pointer underline text-[#706B8B]"><?= $block->escapeHtml(__('register with email')) ?></p>
        </div>
    </div>

    <script>
        function registerArea() {
            return {
                open: false,

                init() {
                    // Check mage-messages cookie (Hyvä still uses it)
                    const messages = window.hyva?.getCookie('mage-messages');

                    if (messages && messages.length) {
                        this.open = true;
                        this.showForm();
                    }

                    // If toggle doesn't exist → fallback behavior
                    if (!document.querySelector('.link-toggle')) {
                        this.open = true;
                        this.showForm();
                        this.removePasswordFields();
                    }
                },

                toggle() {
                    this.open = !this.open;
                    this.showForm();
                },

                showForm() {
                    const form = document.querySelector('.form-create-account');
                    if (!form) return;

                    form.style.display = this.open ? 'block' : 'none';
                },

                removePasswordFields() {
                    document.querySelectorAll(
                        '.form-create-account label[for="password"], .form-create-account label[for="password-confirmation"]'
                    ).forEach(el => el.parentElement.remove());
                }
            }
        }
    </script>
<?php endif; ?>
