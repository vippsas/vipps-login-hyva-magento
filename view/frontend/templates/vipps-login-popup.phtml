<?php
    declare(strict_types=1);
    /** @var $block \Magento\Framework\View\Element\Template */
?>

<div x-data="vippsPopup()"
     @private-content-loaded.window="receiveCustomerData($event.detail.data)"
     x-init="init()"
     x-cloak
>
    <div
        x-show="open"
        x-transition
        class="fixed flex inset-0 items-center justify-center z-50">
        <div class="absolute inset-0 bg-black/50" @click="close"></div>

        <div class="bg-white rounded-2xl shadow-xl p-6 max-w-lg w-full relative z-10">
            <button
                @click="close"
                class="absolute top-3 right-3 text-gray-500 hover:text-black"
                aria-label="<?= $block->escapeHtml(__('Close')) ?>"
            >
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="w-5 h-5"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <h2 class="text-xl font-semibold mb-2">
                <?= $block->escapeHtml(__('Updated address?')); ?>
            </h2>

            <p class="mb-4">
                <?= $block->escapeHtml(__("You've updated your addresses in Vipps since your last visit. Should we update our records?")); ?>
            </p>

            <template x-if="data?.newAddress">
                <div class="mb-3">
                    <strong><?= $block->escapeHtml(__('New address from Vipps')); ?></strong>
                    <p x-text="data.newAddress.customer_display_name"></p>
                    <p x-text="data.newAddress.street"></p>
                    <p x-text="data.newAddress.postalcode + ', ' + data.newAddress.city"></p>
                </div>
            </template>

            <template x-if="data?.oldAddress">
                <div class="mb-3">
                    <strong><?= $block->escapeHtml(__('Old address')); ?></strong>
                    <p x-text="data.oldAddress.customer_display_name"></p>
                    <p x-text="data.oldAddress.street"></p>
                    <p x-text="data.oldAddress.postalcode + ', ' + data.oldAddress.city"></p>
                </div>
            </template>

            <label class="flex items-center gap-2 mt-4">
                <input type="checkbox" x-model="remember">
                <span><?= $block->escapeHtml(__('Remember my choice')); ?></span>
            </label>

            <div class="mt-6 flex gap-3 justify-end">
                <button @click="doNothing" class="px-4 py-2 border rounded">
                    <?= $block->escapeHtml(__('Do nothing')); ?>
                </button>

                <button @click="updateAddress" class="px-4 py-2 bg-black text-white rounded">
                    <?= $block->escapeHtml(__('Update')); ?>
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    function vippsPopup() {
        return {
            open: false,
            data: null,
            remember: false,

            init() {
                if (window.customerData) {
                    this.receiveCustomerData(window.customerData);
                }
            },

            receiveCustomerData(data) {
                const vipps = data?.vipps_login_data;

                if (vipps?.show_popup && document.querySelector('.account')) {
                    this.data = vipps;
                    this.open = true;
                }
            },

            close() {
                this.open = false;
                this.send(2);
            },

            doNothing() {
                this.open = false;
                this.send(2);
            },

            updateAddress() {
                this.open = false;
                this.send(0);
            },

            send(mode) {
                fetch('/vipps/login/addressUpdate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        sync_address_mode: mode,
                        sync_address_remember: this.remember
                    })
                });
            }
        }
    }
</script>
